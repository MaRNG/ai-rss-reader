{
	"name": "siftly/siftly",
	"description": "Siftly – osobní RSS čtečka",
	"type": "project",
	"license": "proprietary",
	"require": {
		"php": ">=8.4",
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-fileinfo": "*",
		"ext-mbstring": "*",
		"ext-pdo_mysql": "*",
		"nette/application": "^3.3",
		"nette/assets": "^1.0",
		"nette/bootstrap": "^3.3",
		"nette/di": "^3.2",
		"nette/forms": "^3.3",
		"nette/http": "^3.4",
		"nette/security": "^3.2",
		"nette/utils": "^4.1",
		"latte/latte": "^3.1",
		"tracy/tracy": "^2.12",
		"contributte/console": "^0.11",
		"nettrine/cache": "^0.5",
		"nettrine/dbal": "^0.10",
		"nettrine/orm": "^0.10",
		"nettrine/migrations": "^0.10",
		"symfony/lock": "^8.1",
		"symfony/process": "^8.1",
		"simplepie/simplepie": "^1.9",
		"fivefilters/readability.php": "^4.1",
		"ezyang/htmlpurifier": "^4.19"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-doctrine": "^2.0",
		"phpstan/phpstan-nette": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"App\\": "App/"
		}
	},
	"config": {
		"sort-packages": true,
		"optimize-autoloader": true,
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
