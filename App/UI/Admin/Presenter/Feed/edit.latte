{import '../formBlocks.latte'}
{block title}{$feed->getTitle()} – administrace{/block}

{block content}
	<header class="topbar">
		<button class="topbar__menu" type="button" data-drawer-open aria-controls="feeds" aria-expanded="false" aria-label="Zobrazit menu"><i data-lucide="menu"></i></button>
		<div class="topbar__title">
			<h1>{$feed->getTitle()}</h1>
			<p>Úprava feedu</p>
		</div>
	</header>
	<div class="page page--narrow">
		{include adminForm, form: $control['editForm'], cancel: $presenter->link('default')}
	</div>
{/block}
